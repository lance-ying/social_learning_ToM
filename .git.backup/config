[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/lance-ying/social_learning_ToM.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "ryan/development"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/ryan/development
[lfs]
	repositoryformatversion = 0
[lfs "https://github.com/lance-ying/social_learning_ToM.git/info/lfs"]
	access = basic
